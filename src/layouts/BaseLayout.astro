---
import '../styles/global.css';
import Appearance from '../components/Appearance.astro';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  description?: string;
  active?: 'home' | 'archive' | 'about';
  noindex?: boolean;
  article?: { author: string; publishedAt: Date; updatedAt?: Date };
}
const { title, description = '我的个人博客。', active, noindex = false, article } = Astro.props;
const pageTitle = title ? `${title} · vtroiswhite` : 'vtroiswhite · 我的个人博客';
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = article ? {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  url: canonical.href, datePublished: article.publishedAt.toISOString(),
  dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
  author: { '@type': 'Person', name: article.author },
  publisher: { '@type': 'Person', name: 'vtroiswhite' },
} : undefined;
---
<!doctype html>
<html lang="zh-CN" data-style="developer" data-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f5f5" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="vtroiswhite 的博客" href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="vtroiswhite" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    {article && <meta property="article:published_time" content={article.publishedAt.toISOString()} />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />}
    <script is:inline>
      (() => {
        const key = 'vtroiswhite:appearance:v1';
        const root = document.documentElement;
        let style = 'developer', mode = 'system';
        try {
          const raw = localStorage.getItem(key);
          if (raw) {
            const value = JSON.parse(raw);
            if (value && value.version === 1 && ['developer', 'paper'].includes(value.style) && ['light', 'dark', 'system'].includes(value.mode)) {
              style = value.style; mode = value.mode;
            } else localStorage.removeItem(key);
          }
        } catch { try { localStorage.removeItem(key); } catch {} }
        root.dataset.style = style;
        root.dataset.mode = mode;
        root.dataset.theme = mode === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : mode;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="brand" href="/" aria-label="vtroiswhite 博客首页"><span class="brand-symbol" aria-hidden="true"><span class="developer-mark">~/</span><span class="paper-mark">v.</span></span><span>vtroiswhite<span class="brand-dot">.</span></span></a>
        <nav class="main-nav" aria-label="主导航">
          <a href="/" aria-current={active === 'home' ? 'page' : undefined}>文章</a>
          <a href="/archive/" aria-current={active === 'archive' ? 'page' : undefined}>归档</a>
          <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>关于</a>
        </nav>
        <Appearance />
      </div>
    </header>
    <main id="main" class="shell main-content"><slot /></main>
    <footer class="site-footer shell">
      <div class="footer-signature"><span class="footer-mark" aria-hidden="true">v.</span><span>© {new Date().getUTCFullYear()} vtroiswhite</span></div>
      <div class="footer-links"><a href="https://github.com/vtroisWhite" target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} /> GitHub<span class="sr-only">（新窗口）</span></a><a href="/rss.xml"><Icon name="rss" size={16} /> RSS</a><a href="#main" class="back-top" aria-label="返回顶部"><Icon name="up" size={16} /></a></div>
    </footer>
    <div class="sr-only" role="status" aria-live="polite" data-ui-status></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
