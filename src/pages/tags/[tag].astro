---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap(post => post.data.tags))].map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) } }));
}
interface Props { tag: string; posts: Post[]; }
const { tag, posts } = Astro.props;
---
<BaseLayout title={`标签：${tag}`} active="archive">
  <header class="page-intro"><div class="eyebrow">FILED UNDER</div><h1 class="page-title"># {tag}</h1><p class="page-lead">关于这个话题的 {posts.length} 篇记录。</p></header>
  {posts.map((post, index) => <PostCard post={post} index={index} />)}
  <a class="back-link" href="/archive/">← 查看全部归档</a>
</BaseLayout>
